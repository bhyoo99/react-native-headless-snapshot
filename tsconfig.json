{
    "compilerOptions": {
        "target": "es2022",
        "module": "preserve",
        "moduleResolution": "bundler",
        "rootDir": "src",
        "outDir": "build",
        "pretty": true,
        "strict": false,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "jsx": "react-jsx",
        "types": ["jest", "node"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ]
}
