{
  "name": "jest-snapshots-svg",
  "version": "0.1.0",
  "description": "Generate SVG Snapshots of React Native Component Trees",
  "main": "build/index.js",
  "files": [
    "build"
  ],
  "typings": "build/index.d.ts",
  "author": "Orta Therox <orta.therox@gmail.com> & Art.sy Inc",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-transform-import-meta": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "fontkit": "^3.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "linebreak": "^2.0.0",
    "lint-staged": "^17.6.1",
    "react": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "yoga-layout": "^3.2.1"
  },
  "scripts": {
    "test": "jest",
    "type-check": "tsc --noEmit",
    "build": "npm run build:js && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/font', 'build/font', { recursive: true })\"",
    "build:js": "esbuild src/index.ts --bundle --platform=node --conditions=browser --format=cjs --target=node18 --outfile=build/index.js",
    "watch": "npm run build:js -- --watch",
    "lint": "eslint .",
    "prepare": "npm run build && husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --fix"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "testRegex": "(.test)\\.(ts|tsx)$",
    "transformIgnorePatterns": [
      "/node_modules/(?!(yoga-layout|fontkit|linebreak|brotli|dfa|restructure|unicode-properties|unicode-trie)/)"
    ],
    "cacheDirectory": ".jest/cache"
  },
  "dependencies": {},
  "peerDependencies": {
    "jest": ">=29"
  }
}
