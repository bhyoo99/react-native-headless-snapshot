{
  "name": "jest-snapshots-svg",
  "version": "0.1.0",
  "description": "Generate SVG Snapshots of React Native Component Trees",
  "main": "build/index.js",
  "files": [
    "build/*"
  ],
  "typings": "build/index.d.ts",
  "author": "Orta Therox <orta.therox@gmail.com> & Art.sy Inc",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-transform-import-meta": "^3.1.0",
    "danger": "^0.18.0",
    "esbuild": "^0.28.2",
    "husky": "^0.13.3",
    "jest": "^30.5.2",
    "lint-staged": "^3.2.5",
    "react": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "test-renderer": "^1.3.1",
    "ts-node": "^3.0.0",
    "tslint": "^5.2.0",
    "typescript": "^6.0.3",
    "yoga-layout": "^3.2.1"
  },
  "scripts": {
    "test": "jest",
    "type-check": "tsc --noEmit",
    "build": "yarn build:js && tsc --emitDeclarationOnly && cp -r src/font build",
    "build:js": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --external:fontkit --external:linebreak --outfile=build/index.js",
    "watch": "yarn build:js --watch",
    "lint": "tslint 'src/**/*.{ts,tsx}'",
    "precommit": "lint-staged",
    "prepush": "yarn build && yarn jest"
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "tslint --fix",
      "git add"
    ]
  },
  "jest": {
    "testRegex": "(.test)\\.(ts|tsx)$",
    "transformIgnorePatterns": [
      "/node_modules/(?!yoga-layout/)"
    ],
    "cacheDirectory": ".jest/cache"
  },
  "dependencies": {
    "fontkit": "^1.7.7",
    "linebreak": "^0.3.0"
  }
}
